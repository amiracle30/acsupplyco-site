{
  "id": "pastry-boxes",
  "slug": "pastry-boxes",
  "title": "Custom printed cake and pastry boxes",
  "category": "bakery-packaging",
  "status": "preview",
  "short_description": "Your bakes, boxed in your brand. Printed cake and pastry boxes in three sizes, on kraft or white board.",
  "description": "The box goes home with the customer and opens on a kitchen table in front of other people — the best advert a bakery gets. Choose the size, the number of print colours and the board, then put your name on the lid.\n\nYour digital proof and print plates are included in the price. Final specifications are confirmed with your written quote.",
  "benefits": [
    "1, 2 or 3 colour print",
    "Three box sizes",
    "Your own artwork"
  ],
  "faqs": [
    {
      "q": "Can I use my own design?",
      "a": "Yes. Share your logo or print-ready artwork when requesting a quote. We will confirm the artwork requirements for your chosen box, and you approve a digital proof before anything is printed."
    },
    {
      "q": "What if my artwork is not ready?",
      "a": "You can request a quote first and share your artwork later. Tell us what you have in mind and we can discuss the next steps."
    },
    {
      "q": "Are the prices shown final?",
      "a": "The prices on this page are indicative and exclude VAT, which is added at 20%. Your digital proof and print plates are included, and delivery is free to a single UK mainland address. We confirm everything in a written quote before you commit."
    },
    {
      "q": "Which size do I need?",
      "a": "Small (8 × 8 × 4 in) suits doughnuts, cupcakes and a small cake. Medium (10 × 6 × 3.5 in) suits pastries, tarts and traybakes. Large suits full-size cakes and larger mixed boxes. Tell us what you bake and we will advise."
    },
    {
      "q": "Can I have a window in the lid?",
      "a": "Windowed lids are available on request. Mention it in your enquiry and we will include it in your quote."
    },
    {
      "q": "Can the boxes be laminated?",
      "a": "Gloss and matte lamination are available and are quoted on request. Select the finish you want and send us the configuration."
    },
    {
      "q": "When will my boxes arrive?",
      "a": "As a general guide, allow several weeks from artwork approval to delivery. We will confirm current timing with your quote."
    }
  ],
