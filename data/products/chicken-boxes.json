{
  "id": "chicken-boxes",
  "slug": "chicken-boxes",
  "title": "Custom printed chicken boxes",
  "category": "takeaway-packaging",
  "status": "preview",
  "short_description": "Your chicken. Your name on the box. Printed fried chicken boxes in five sizes, from snack boxes to a handled sharing bucket.",
  "description": "Five formats cover the menu: three rectangular boxes, a square box and a tall bucket with a carry handle. Choose the size, the number of print colours and the board, then put your brand on every order that leaves the counter.\n\nServing burgers or wraps as well? See our [printed burger boxes](/takeaway-packaging/burger-boxes/) and [takeaway and wrap boxes](/takeaway-packaging/meal-boxes/). Line boxes with [printed greaseproof paper](/catering-supplies/greaseproof-paper/).\n\nYour digital proof and print plates are included in the price. Final specifications are confirmed with your written quote.",
  "benefits": [
    "1, 2 or 3 colour print",
    "Five box sizes",
    "Your own artwork"
  ],
  "faqs": [
    {
      "q": "Can I use my own design?",
      "a": "Yes. Share your logo or print-ready artwork when requesting a quote. We will confirm the artwork requirements for your chosen box, and you approve a digital proof before anything is printed."
    },
    {
      "q": "What if my artwork is not ready?",
      "a": "You can request a quote first and share your artwork later. Tell us what you have in mind and we can discuss the next steps."
    },
    {
      "q": "Are the prices shown final?",
      "a": "The prices on this page are indicative and exclude VAT, which is added at 20%. Your digital proof and print plates are included, and delivery is free to a single UK mainland address. We confirm everything in a written quote before you commit."
    },
    {
      "q": "Why do the quantity options change between sizes?",
      "a": "Each size is produced differently, so the price breaks are not the same for every box. If the quantity you need is not listed, use “Request a custom quantity” and we will quote it."
    },
    {
      "q": "Can the boxes be laminated?",
      "a": "Gloss and matte lamination are available and are quoted on request. Select the finish you want and send us the configuration."
    },
    {
      "q": "When will my boxes arrive?",
      "a": "As a general guide, allow several weeks from artwork approval to delivery. We will confirm current timing with your quote."
    }
  ],
